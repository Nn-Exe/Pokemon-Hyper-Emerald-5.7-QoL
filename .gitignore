# Never commit ROMs, saves or emulator binaries
*.gba
*.bak
*.sav
*.ss*
*.nro
__pycache__/
*.png
!docs/**/*.png
!site/public/**/*.png
!patches/questlog/badges/sinnoh.png
!patches/paldea/sprites/src/*.png
!patches/azpeople/sprites/*.png
!patches/kitakami/sprites/src/*.png
*_log.txt
*_done.txt

# ROM-mining outputs (regenerate with tools/romdata/*.py)
tools/romdata/out/
tools/romdata/__pycache__/
lz_blobs.json
.DS_Store

# Guide site (Astro): the source is site/, the build is copied into docs/ (site/scripts/publish.mjs)
site/node_modules/
site/dist/
site/.astro/

# the leftover-Chinese generators: scan output (2.9 MB, regenerated by scan.py)
translation/official/scan_now.json

# gen9abil: the compiler's objects (build.py writes them; gen9abil.bin and .sym are what the patcher reads)
patches/gen9abil/build/

# gen9anim: the assembler's objects (gen9anim.bin and .sym are what the patcher reads)
patches/gen9anim/build/
