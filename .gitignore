# Never commit ROMs, saves or emulator binaries
*.gba
*.bak
*.sav
*.ss*
*.nro
__pycache__/
*.png
!docs/showcase/*.png
*_log.txt
*_done.txt

# ROM-mining outputs (regenerate with tools/romdata/*.py)
tools/romdata/out/
tools/romdata/__pycache__/
lz_blobs.json

# Local toolchain and scratch (not part of the repo)
.venv/
tools/mgba-dev/
build/

# macOS
.DS_Store

# Command Code session state
.commandcode/
