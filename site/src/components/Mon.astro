---
// A Pokémon name with its menu icon, linked to its Pokédex page.
import { speciesId, spritePos } from '../lib/data';
import { pokedexUrl, speciesBySid } from '../lib/pokedex';

interface Props {
  name?: string;
  sid?: number;
  /** text to print instead of the species name */
  label?: string;
  link?: boolean;
  /** icon only */
  bare?: boolean;
  size?: 'x15' | 'x2';
}
const { name, sid: given, label, link = true, bare = false, size } = Astro.props;
const sid = given ?? speciesId(name!);
const text = label ?? name ?? '';
const href = link ? pokedexUrl(sid) : undefined;
const icon = ['spr', 'spr-mon', size];
---

{
  bare ? (
    <span class:list={icon} style={spritePos('mon', sid)} role="img" aria-label={text || undefined} />
  ) : href ? (
    <a class="mon" href={href} title={`${speciesBySid(sid)!.name} in the Pokédex`}>
      <span class:list={icon} style={spritePos('mon', sid)} aria-hidden="true" />
      <span>{text}</span>
    </a>
  ) : (
    <span class="mon">
      <span class:list={icon} style={spritePos('mon', sid)} aria-hidden="true" />
      <span>{text}</span>
    </span>
  )
}
