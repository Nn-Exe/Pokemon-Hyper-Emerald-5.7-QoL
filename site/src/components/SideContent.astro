---
// One group of the side content outside the Journal (src/data/side-content.json, read from the game's scripts).
import groups from '../data/side-content.json';

interface Props {
  /** the group's title in the data file */
  group: string;
}
const { group } = Astro.props;
const g = groups.find((x) => x.title === group);
if (!g) throw new Error(`SideContent: unknown group "${group}"`);
---

<p>{g.blurb}</p>
<div class="table-shell" tabindex="0" role="region" aria-label={g.title}>
  <table class="stack-table">
    <thead>
      <tr>
        <th scope="col">Where</th>
        <th scope="col">What</th>
      </tr>
    </thead>
    <tbody>
      {
        g.rows.map((r) => (
          <tr>
            <th scope="row">{r.where}</th>
            <td>{r.what}</td>
          </tr>
        ))
      }
    </tbody>
  </table>
</div>
