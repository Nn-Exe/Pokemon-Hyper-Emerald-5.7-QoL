{
  "name": "hyper-emerald-guide",
  "private": true,
  "type": "module",
  "version": "2.0.0",
  "description": "Player's guide for Pokémon Hyper Emerald: Lost Artifacts v5.7 with the English + QoL patch. Builds into ../docs for GitHub Pages.",
  "scripts": {
    "dev": "node ./node_modules/astro/bin/astro.mjs dev",
    "build": "node ./node_modules/astro/bin/astro.mjs build && node scripts/publish.mjs",
    "build:site": "node ./node_modules/astro/bin/astro.mjs build",
    "publish": "node scripts/publish.mjs",
    "preview": "node scripts/serve-docs.mjs",
    "check": "node scripts/check-links.mjs",
    "package:infinityfree": "node scripts/package-infinityfree.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.1",
    "@astrojs/mdx": "^8.0.2",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/archivo": "^5.2.8",
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource/silkscreen": "^5.2.8",
    "astro": "^7.3.5"
  }
}
